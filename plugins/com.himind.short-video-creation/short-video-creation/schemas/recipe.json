{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HiMind Short Video Recipe",
  "type": "object",
  "required": ["template_id", "style_id", "duration_seconds", "canvas", "safe_area", "data"],
  "properties": {
    "template_id": {"type": "string"},
    "template_version": {"type": "string"},
    "style_id": {"type": "string"},
    "style_version": {"type": "string"},
    "adapter": {"type": "string", "enum": ["remotion", "hyperframes"], "default": "remotion"},
    "title": {"type": "string"},
    "subtitle": {"type": "string"},
    "duration_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
    "canvas": {
      "type": "object",
      "required": ["width", "height", "fps"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "fps": {"type": "integer", "minimum": 1, "maximum": 120}
      },
      "additionalProperties": false
    },
    "safe_area": {
      "type": "object",
      "required": ["top", "right", "bottom", "left"],
      "properties": {
        "top": {"type": "integer", "minimum": 0},
        "right": {"type": "integer", "minimum": 0},
        "bottom": {"type": "integer", "minimum": 0},
        "left": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "data": {"type": "object", "minProperties": 1},
    "items": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
