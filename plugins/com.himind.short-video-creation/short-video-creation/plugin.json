{
  "id": "com.himind.short-video-creation",
  "name": "短视频创作引擎",
  "author": "马宝全",
  "categories": ["video-post", "visual-design", "content-production", "testing-quality"],
  "description": "提供模板优先的短视频项目、故事板预览、Remotion 真实成片、反馈沉淀、质量检查和 HyperFrames 适配能力。",
  "release_notes": "优化短视频项目窗口的工作区栏和窄窗口布局，操作按钮保持稳定可读；统一多引擎创作文案，继续以 Remotion 为内置主引擎并保留 HyperFrames 同级适配协议。",
  "version": "0.3.2",
  "entry": "bin/short-video-creation.exe",
  "runtime": "process-jsonrpc-stdio",
  "platforms": ["windows-x64"],
  "min_agent_version": "0.3.40",
  "governance": "optional",
  "plugin_dependencies": [],
  "capabilities": [
    {"id": "short.video.catalog.list", "description": "列出可用的短视频模板、风格包和渲染适配器。", "input_schema": {"type": "object", "properties": {"family": {"type": "string"}}, "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.runtime.status", "description": "检查内置 Remotion 和可插拔渲染引擎的运行状态。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}}, "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.style.list", "description": "列出可复用的短视频风格包及其视觉、动效和质量规则。", "input_schema": {"type": "object", "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.style.describe", "description": "读取指定风格包的完整规则和版本信息。", "input_schema": {"type": "object", "properties": {"style_id": {"type": "string"}, "version": {"type": "string"}}, "required": ["style_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.template.list", "description": "按模板族或风格筛选可实例化的短视频模板。", "input_schema": {"type": "object", "properties": {"family": {"type": "string"}, "style_id": {"type": "string"}}, "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.template.describe", "description": "读取指定短视频模板的插槽、适配器和兼容风格。", "input_schema": {"type": "object", "properties": {"template_id": {"type": "string"}, "version": {"type": "string"}}, "required": ["template_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.project.create", "description": "在调用方指定的任意项目目录创建短视频项目和默认 Recipe。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "template_id": {"type": "string"}, "style_id": {"type": "string"}, "data": {"type": "object"}}, "required": ["workspace_root", "name", "template_id", "style_id"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.project.list", "description": "列出指定项目目录下已创建的短视频项目。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.project.get", "description": "读取短视频项目、当前 Recipe、最近任务和产物。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}}, "required": ["workspace_root", "project_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.project.update", "description": "在项目目录内保存新的 Recipe 或项目描述，并进行版本与并发校验。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "name": {"type": "string"}, "description": {"type": "string"}, "expected_updated_at": {"type": "string"}, "recipe": {"type": "object"}}, "required": ["workspace_root", "project_id"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.recipe.validate", "description": "校验项目或临时 Recipe 的模板、风格、画布、时长、数据和安全区。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "recipe": {"type": "object"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.preview.start", "description": "根据 Recipe 生成可在浏览器打开的 HTML 故事板预览。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "recipe": {"type": "object"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.preview.status", "description": "查询短视频预览 Job 的进度和产物。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "job_id": {"type": "string"}}, "required": ["workspace_root", "job_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.preview.cancel", "description": "取消尚未完成的短视频预览 Job。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "job_id": {"type": "string"}}, "required": ["workspace_root", "job_id"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.feedback.record", "description": "记录预览反馈并标记可沉淀为模板变体或风格规则的结果。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "category": {"type": "string"}, "feedback": {"type": "string"}, "accepted": {"type": "boolean"}, "preview_job_id": {"type": "string"}}, "required": ["workspace_root", "project_id", "category", "feedback"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.feedback.list", "description": "读取项目的预览反馈，支持只看已接受反馈。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "accepted_only": {"type": "boolean"}}, "required": ["workspace_root", "project_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.candidate.save", "description": "保存带证据的模板变体、风格包或质量规则候选，不直接覆盖扩展源资产。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "candidate_type": {"type": "string", "enum": ["template_variant", "style_pack", "quality_rule"]}, "base_template_id": {"type": "string"}, "base_template_version": {"type": "string"}, "base_style_id": {"type": "string"}, "base_style_version": {"type": "string"}, "changes": {"type": "object"}, "evidence": {"type": "array"}, "source_feedback_ids": {"type": "array", "items": {"type": "string"}}}, "required": ["workspace_root", "project_id", "candidate_type", "changes", "evidence"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.candidate.list", "description": "列出指定目录中待复核的模板、风格和质量候选。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.candidate.get", "description": "读取一个候选资产及其来源证据。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "candidate_id": {"type": "string"}}, "required": ["workspace_root", "candidate_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.quality.check", "description": "执行确定性的 Recipe 质量门禁并返回可修复问题。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "recipe": {"type": "object"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.render.start", "description": "使用内置 Remotion 后台任务或已注册适配器构建最终视频。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "project_id": {"type": "string"}, "recipe": {"type": "object"}}, "required": ["workspace_root"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.render.status", "description": "查询最终视频渲染 Job 的状态、进度和产物。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "job_id": {"type": "string"}}, "required": ["workspace_root", "job_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.render.cancel", "description": "取消尚未完成的最终视频渲染 Job。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "job_id": {"type": "string"}}, "required": ["workspace_root", "job_id"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.render.complete", "description": "由外部 Renderer Adapter 回写渲染结果并登记视频 Artifact。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "job_id": {"type": "string"}, "status": {"type": "string", "enum": ["completed", "failed"]}, "artifact_path": {"type": "string"}, "artifact_kind": {"type": "string"}, "renderer": {"type": "string"}, "message": {"type": "string"}}, "required": ["workspace_root", "job_id", "status"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"},
    {"id": "short.video.artifact.export", "description": "按 Artifact ID 返回已生成预览或视频产物的路径、大小和 SHA-256。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "artifact_id": {"type": "string"}}, "required": ["workspace_root", "artifact_id"], "additionalProperties": false}, "risk_level": "read_only", "availability": "local"},
    {"id": "short.video.artifact.open", "description": "用系统应用打开工作区内已登记的预览、视频或所在目录。", "input_schema": {"type": "object", "properties": {"workspace_root": {"type": "string"}, "artifact_id": {"type": "string"}, "mode": {"type": "string", "enum": ["file", "folder"]}}, "required": ["workspace_root", "artifact_id"], "additionalProperties": false}, "risk_level": "local_write", "availability": "local"}
  ],
  "permissions": ["filesystem.workspace.read", "filesystem.workspace.write", "process.node", "network.package-registry", "process.system-open"],
  "contributes": {"commands": [{"id": "short.video.project.create", "title": "创建短视频项目"}, {"id": "short.video.project.update", "title": "保存短视频 Recipe"}, {"id": "short.video.preview.start", "title": "生成短视频预览"}, {"id": "short.video.render.start", "title": "构建最终视频"}, {"id": "short.video.candidate.save", "title": "保存风格候选"}], "views": [{"id": "short-video-projects", "title": "短视频项目", "location": "plugin_navigation", "entry": "ui/index.html"}]}
}
